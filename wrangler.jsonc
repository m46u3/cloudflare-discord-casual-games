{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-discord-casual-games",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "discord-bot-db",
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID"
    }
  ]
}
